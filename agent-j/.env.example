# Copy this file to agent-j/.env. Never commit the resulting file.

# Required Agent J application/server identifiers.
AGENT_J_CLIENT_ID=
AGENT_J_GUILD_ID=

# On Windows, use scripts/Set-DiscordTokenFromClipboard.ps1 instead.
# AGENT_J_DISCORD_TOKEN=

# Comma-separated roles allowed to use entertainment and Arena commands.
AGENT_J_ACCESS_ROLE_IDS=
AGENT_J_PROTECTED_ROLE_IDS=

# Arena output and test channels.
AGENT_J_ARENA_CHANNEL_ID=
AGENT_J_ARENA_RESULTS_CHANNEL_ID=
AGENT_J_ARENA_CLEANUP_SECONDS=300
AGENT_J_TEST_CHANNEL_ID=
AGENT_J_ALLOW_OPTED_OUT_INVOKERS=false

# Role-gated, live-web research. Keep disabled until the OpenAI credential,
# Discord Message Content intent, allowed roles, and allowed channels are set.
AGENT_J_RESEARCH_ENABLED=false
AGENT_J_RESEARCH_ROLE_IDS=
AGENT_J_RESEARCH_CHANNEL_IDS=
AGENT_J_RESEARCH_STANDARD_MODEL=gpt-5.6-luna
AGENT_J_RESEARCH_DEEP_MODEL=gpt-5.6-terra
AGENT_J_RESEARCH_TIMEOUT_SECONDS=90

# Hard context ceilings.
AGENT_J_RESEARCH_FOCUSED_MESSAGE_LIMIT=10
AGENT_J_RESEARCH_STANDARD_MESSAGE_LIMIT=25
AGENT_J_RESEARCH_FOCUSED_CHARACTER_LIMIT=6000
AGENT_J_RESEARCH_STANDARD_CHARACTER_LIMIT=12000

# On Windows, use scripts/Set-OpenAIKeyFromClipboard.ps1 instead.
# AGENT_J_OPENAI_API_KEY=

# Optional local runtime-state override.
# Windows default: %LOCALAPPDATA%\AliensAnonymous\AgentJ
# Linux/macOS default: ~/.local/share/AliensAnonymous/AgentJ
AGENT_J_DATA_DIR=

# Optional local artwork paths for npm run update-profile.
AGENT_J_AVATAR_PATH=
AGENT_J_BANNER_PATH=
