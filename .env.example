# Copy this file to .env and fill only the features you intend to enable.
# Never commit .env or paste bot tokens into source code.

# Required Agent K application/server identifiers.
DISCORD_CLIENT_ID=
DISCORD_GUILD_ID=

# On Windows, use scripts/Set-DiscordTokenFromClipboard.ps1 instead.
# For other hosts, expose the token only to the bot process.
# DISCORD_TOKEN=

# Optional comma-separated role IDs allowed to issue citations. Members with
# Manage Messages or Administrator are also accepted by the default policy.
CITATION_ROLE_IDS=
CITATION_COOLDOWN_SECONDS=15
CHAT_RESPONSE_COOLDOWN_SECONDS=5

# Optional link used by the intentionally overdramatic "orb" responses.
ORB_REFERENCE_URL=https://example.com/orb-archive

# Rich star archive. Create a destination channel and place its ID here.
ARCHIVE_ENABLED=false
ARCHIVE_CHANNEL_ID=

# Credential-free X monitoring through Nitter RSS.
NITTER_MONITOR_ENABLED=false
UAP_ALERT_CHANNEL_ID=
NITTER_POLL_INTERVAL_SECONDS=600
NITTER_MAX_ITEMS_PER_POLL=3

# Optional legacy alert-bot account whose duplicate posts Agent K may remove.
READYBOT_USER_ID=

# Optional database overrides. Defaults use the ignored data/ directory.
# CITATION_DB_PATH=
# AUTOMATION_DB_PATH=

# US-first, low-volume breaking-news monitor.
EARTH_INTEL_ENABLED=false
EARTH_INTEL_CHANNEL_ID=
EARTH_INTEL_OPS_CHANNEL_ID=
EARTH_INTEL_OWNER_USER_ID=
EARTH_INTEL_SCHEDULER_INTERVAL_SECONDS=60
EARTH_INTEL_DAILY_SOFT_CAP=6
EARTH_INTEL_MAX_ITEMS_PER_SOURCE_PER_CYCLE=5
EARTH_INTEL_NITTER_INSTANCES=https://nitter.net
# EARTH_INTEL_DB_PATH=

# Optional self-service Agent J role assignment from one reaction.
Q_AND_A_CHANNEL_ID=
FIELD_CLEARANCE_ROLE_ID=
FIELD_CLEARANCE_MESSAGE_ID=
FIELD_CLEARANCE_EMOJI=🕶️

# Optional manual DISBOARD reminder schedule.
BUMP_REMINDER_ENABLED=false
BUMP_REMINDER_CHANNEL_ID=
BUMP_CREW_ROLE_ID=
DISBOARD_USER_ID=
BUMP_REMINDER_TIME_ZONE=America/New_York
BUMP_REMINDER_TIMES=00:00,08:00,12:00,16:00,20:00
BUMP_REMINDER_GRACE_MINUTES=10
BUMP_REMINDER_SCHEDULER_INTERVAL_SECONDS=30
DISBOARD_BUMP_COOLDOWN_SECONDS=7380
